# API
FAF_API_BASE_URL=https://api-publica.transferegov.gestao.gov.br/fundoafundo
FAF_API_TAMANHO_PAGINA=1000
FAF_API_TIMEOUT=120
FAF_API_MAX_TENTATIVAS=6
FAF_API_CONCORRENCIA=4
FAF_API_USER_AGENT=faf-carga/0.1 (transferepro)

# Banco (PostgreSQL local)
FAF_DB_HOST=localhost
FAF_DB_PORT=5433
FAF_DB_NOME=transferepro
FAF_DB_USUARIO=
FAF_DB_SENHA=
FAF_DB_ESQUEMA=base_transferencias_fundo_fundo
FAF_DB_ESQUEMA_STG=stg_transferencias_fundo_fundo
# Tablespace opcional para tabelas/índices/temporários (vazio = padrão do banco); ex.: ts_faf em D:\pgdata_faf
FAF_DB_TABLESPACE=
# statement_timeout da sessão de carga (o COPY do download é um comando único e longo)
FAF_DB_STATEMENT_TIMEOUT=4h
# limite de cada comando do merge incremental (normalmente dura segundos)
FAF_DB_MERGE_TIMEOUT=30min

# Log
FAF_LOG_NIVEL=INFO
FAF_LOG_DIR=logs
